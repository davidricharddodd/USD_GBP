# Environment Variables for Railway Deployment
# Copy this file to .env and fill in your values

# Database Connection (provided by Railway PostgreSQL service)
DATABASE_URL=postgresql://user:password@host:port/dbname
FLOOT_DATABASE_URL=postgresql://user:password@host:port/dbname

# Node.js Runtime
NODE_ENV=production
PORT=3000

# Security & Authentication
ADMIN_PASSWORD_HASH=<your-admin-password-hash-here>
ADMIN_USERNAME=<your-admin-username-here>
ANTHROPIC_API_KEY=<your-anthropic-api-key-here>
API_KEY=<your-api-key-here>
DATABASE_URL=<your-database-url-here>
FLOOT_DATABASE_URL=<your-floot-database-url-here>
FLOOT_MOBILE_APP_ID=<your-floot-mobile-app-id-here>
FLOOT_OAUTH_CLIENT_ID=<your-floot-oauth-client-id-here>
FLOOT_OAUTH_CLIENT_SECRET=<your-floot-oauth-client-secret-here>
JWT_SECRET=<your-jwt-secret-here>
TELEGRAM_BOT_TOKEN=<your-telegram-bot-token-here>
TELEGRAM_CHAT_ID=<your-telegram-chat-id-here>

# Additional Configuration

# Local Development Only (not used on Railway)
# JWT_SECRET can be generated with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
